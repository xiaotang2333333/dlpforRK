{
    "version": 8,
    "configurePresets": [
        {
            "name": "arm64-linux-dynamic",
            "displayName": "arm64 工具链配置预设",
            "description": "设置生成器、版本和安装目录",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/x64-arm64-toolchain.cmake",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "arm64-linux",
            "displayName": "arm64 static工具链配置预设",
            "description": "设置生成器、版本和安装目录",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain/x64-arm64-toolchain.cmake",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "x64-mingw-dynamic",
            "displayName": "x64 mingw dynamic工具链配置预设",
